    m_PersistentCalls:
      m_Calls: []
  m_text: 'On his brief exit of the forest, the man stumbled upon a deep, dark cave.

    "What a truly frightening sight," the man proclaimed "I''m starting to think being lost out here is better than being lost in there"

    Nonsense, the fright you feel is only your imagination; there''s nothing to truly fear if you have the strength to go forward.

    "But I must insist that it''s truly dark and scary in there, and on that note I will not proceed forward into the cave..."'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6190da2394d123f478209b446c906d21, type: 2}
  m_sharedMaterial: {fileID: 8555249785656010089, guid: 6190da2394d123f478209b446c906d21, type: 2}
